 REXCVAR_DEFINE_BOOL(ignore_thread_priorities, true, "Kernel",
                     "Ignores game-specified thread priorities");
 
@@ -84,6 +87,11 @@
   if (creation_params_.stack_size < 16 * 1024) {
     creation_params_.stack_size = 16 * 1024;
   }
+  // Larger guest stacks (guest_stack_scale), up to 8 MB each.
+  if (guest_thread_ && REXCVAR_GET(guest_stack_scale) > 1) {
+    const uint64_t scaled = uint64_t(creation_params_.stack_size) * uint32_t(REXCVAR_GET(guest_stack_scale));
