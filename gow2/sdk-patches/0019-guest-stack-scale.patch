diff -ru a/src/system/xthread.cpp b/src/system/xthread.cpp
--- a/src/system/xthread.cpp	2026-10-22 11:59:05
+++ b/src/system/xthread.cpp	2026-10-22 11:59:05
@@ -43,6 +43,9 @@
 #include "../core/threading_switch.h"
