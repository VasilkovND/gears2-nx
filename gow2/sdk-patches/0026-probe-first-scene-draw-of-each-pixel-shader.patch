+  if (ps && sondas_ps_.size() < 48 && ((r[gr::XE_GPU_REG_RB_COLOR_INFO] >> 16) & 0xF) == 3 &&
+      sondas_ps_.insert(ps->numero).second) {
+    std::string c;
+    for (uint32_t i = 0; i < 16; ++i) {
+      float v[4];
+      std::memcpy(v, r + kRegConstantesPs + i * 4, sizeof(v));
+      c += fmt::format(" c{}=({:.4g},{:.4g},{:.4g},{:.4g})", i, v[0], v[1], v[2], v[3]);
+    }
+    auto ocupada = [&](uint32_t direccion) -> const char* {
+      if (!direccion) return "sin";
+      const uint8_t* d = memoria_->TranslatePhysical(direccion & 0x1FFFFFFF);
+      for (uint32_t i = 0; i < 4096; ++i) {
+        if (d[i]) return "datos";
+      }
+      return "CEROS";
+    };
+    std::string t;
