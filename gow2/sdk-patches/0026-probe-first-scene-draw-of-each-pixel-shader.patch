+                       (fetch[0] >> 2) & 0xFF, (fetch[4] >> 2) & 0xF, (fetch[4] >> 6) & 0xF, ocupada(base),
+                       ocupada(mips));
+    }
+    REXLOG_INFO("[deko3d] sonda escena: PS n{} VS n{} cuenta {}:{} |{}", ps->numero, p.vs->numero, cuenta, t, c);
