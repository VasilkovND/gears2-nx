+u32 NetDll_getsockopt_entry(u32 caller, u32 socket_handle, u32 level, u32 optname, mapped_void optval_ptr,
+                            mapped_u32 optlen_ptr) {
+  auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(socket_handle);
+  if (!socket) {
+    XThread::SetLastError(0x2736);  // WSAENOTSOCK
+    return -1;
+  }
+  if (!optval_ptr || !optlen_ptr) {
+    XThread::SetLastError(0x271E);  // WSAEFAULT
+    return -1;
+  }
+  uint32_t len = optlen_ptr.value();
+  if (socket->GetOption(level, optname, optval_ptr, &len) != 0) {
+    XThread::SetLastError(0x2726);  // WSAEINVAL
+    return -1;
+  }
+  *optlen_ptr = len;
+  return 0;
+}
