+
+// getsockopt into a guest buffer: 4-byte values as big-endian ints. 0 or -1.
+int XSocket::GetOption(uint32_t level, uint32_t optname, uint8_t* optval_ptr, uint32_t* optlen) {
+  uint8_t value[64];
+  socklen_t len = std::min<uint32_t>(*optlen, sizeof(value));
+  std::memset(value, 0, sizeof(value));
+  const int ret = getsockopt(native_handle_, level, optname, value, &len);
+  if (ret < 0) return -1;
+  if (len == 4) {
+    uint32_t v;
+    std::memcpy(&v, value, 4);
+    v = __builtin_bswap32(v);
+    std::memcpy(value, &v, 4);
+  }
+  std::memcpy(optval_ptr, value, std::min<uint32_t>(len, *optlen));
+  *optlen = len;
+  return 0;
 }
 
