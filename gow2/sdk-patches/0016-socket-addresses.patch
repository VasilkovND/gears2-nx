+// The address a socket is bound to (Gears of War 2 asks after binding its game port; a stub left it garbage).
+u32 NetDll_getsockname_entry(u32 caller, u32 socket_handle, ppc_ptr_t<XSOCKADDR_IN> name, mapped_u32 namelen) {
+  auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(socket_handle);
+  if (!socket) {
+    XThread::SetLastError(0x2736);  // WSAENOTSOCK
+    return -1;
+  }
+  N_XSOCKADDR_IN native;
+  if (socket->GetSockName(&native) != 0) {
+    XThread::SetLastError(0x271E);  // WSAEFAULT
+    return -1;
+  }
+  if (name) {
+    name->sin_family = native.sin_family;
+    name->sin_port = native.sin_port;
+    name->sin_addr = native.sin_addr;
+    std::memset(name->x_sin_zero, 0, sizeof(name->x_sin_zero));
+  }
+  if (namelen) *namelen = sizeof(XSOCKADDR_IN);
+  return 0;
+}
