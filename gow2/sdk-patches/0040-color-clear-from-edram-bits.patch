+// A color target's EDRAM bits as the color they hold (for a clear given as raw bits).
+void ColorDeBitsEdram(uint32_t formato, uint32_t b, float c[4]) {
+  c[0] = c[1] = c[2] = c[3] = 0.0f;
+  switch (formato) {
+    case 2:
+    case 10:
+      for (uint32_t j = 0; j < 3; ++j) c[j] = float((b >> (10 * j)) & 0x3FF) / 1023.0f;
+      c[3] = float(b >> 30) / 3.0f;
+      break;
+    case 3:
+    case 12:
+      for (uint32_t j = 0; j < 3; ++j) c[j] = rex::graphics::xenos::Float7e3To32((b >> (10 * j)) & 0x3FF);
+      c[3] = float(b >> 30) / 3.0f;
+      break;
+    case 4:
+      c[0] = std::max(float(int16_t(b)) / 32767.0f, -1.0f) * 32.0f;
+      c[1] = std::max(float(int16_t(b >> 16)) / 32767.0f, -1.0f) * 32.0f;
+      break;
+    case 6:
+      c[0] = rex::xenos_half_to_float(uint16_t(b));
+      c[1] = rex::xenos_half_to_float(uint16_t(b >> 16));
+      break;
+    case 14:
+      std::memcpy(&c[0], &b, 4);
+      break;
+    default:
+      for (uint32_t j = 0; j < 4; ++j) c[j] = float((b >> (8 * j)) & 0xFF) / 255.0f;
+  }
+}
